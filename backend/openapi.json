  "info": {
    "title": "Anniymah API",
    "description": "Admin + storefront API for the Anniymah backend",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "anniymah_admin_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "example": "your-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Perfumes"
          },
          "slug": {
            "type": "string",
            "example": "perfumes"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Perfumes"
          },
          "slug": {
            "type": "string",
            "example": "perfumes"
          }
        }
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Signature Perfume Combo"
          },
          "slug": {
            "type": "string",
            "example": "signature-perfume-combo"
          },
          "categoryId": {
            "type": "string",
            "description": "Category id, or omit for uncategorized"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "price": {
            "type": "number",
            "example": 999
          },
          "regularPrice": {
            "type": "number",
            "description": "Shown crossed out when higher than price",
            "default": 0
          },
          "freeDelivery": {
            "type": "boolean",
            "default": true
          },
          "deliveryChargeInsideDhaka": {
            "type": "number",
            "default": 0
          },
          "deliveryChargeOutsideDhaka": {
            "type": "number",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "images": {
            "description": "Public URLs from POST /uploads, in display order",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "slug",
          "price"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Signature Perfume Combo"
          },
          "slug": {
            "type": "string",
            "example": "signature-perfume-combo"
          },
          "categoryId": {
            "type": "string",
            "description": "Category id, or omit for uncategorized"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "price": {
            "type": "number",
            "example": 999
          },
          "regularPrice": {
            "type": "number",
            "description": "Shown crossed out when higher than price",
            "default": 0
          },
          "freeDelivery": {
            "type": "boolean",
            "default": true
          },
          "deliveryChargeInsideDhaka": {
            "type": "number",
            "default": 0
          },
          "deliveryChargeOutsideDhaka": {
            "type": "number",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "images": {
            "description": "Public URLs from POST /uploads, in display order",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreatePromotionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Victory Day Sale"
          },
          "discountPercent": {
            "type": "number",
            "example": 16,
            "minimum": 1,
            "maximum": 100
          },
          "startsAt": {
            "type": "string",
            "example": "2026-12-16",
            "description": "Start date/time (ISO 8601)"
          },
          "durationDays": {
            "type": "number",
            "example": 3,
            "minimum": 1,
            "description": "How many days the promotion runs for"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "discountPercent",
          "startsAt",
          "durationDays"
        ]
      },
      "UpdatePromotionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Victory Day Sale"
          },
          "discountPercent": {
            "type": "number",
            "example": 16,
            "minimum": 1,
            "maximum": 100
          },
          "startsAt": {
            "type": "string",
            "example": "2026-12-16",
            "description": "Start date/time (ISO 8601)"
          },
          "durationDays": {
            "type": "number",
            "example": 3,
            "minimum": 1,
            "description": "How many days the promotion runs for"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "RegisterCustomerDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "01712345678",
            "description": "Bangladeshi mobile number"
          },
          "email": {
            "type": "string",
            "example": "shopper@example.com"
          },
          "name": {
            "type": "string",
            "example": "Karim Ahmed"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "LoginCustomerDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Phone or email",
            "example": "01712345678"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "AddCartItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 20,
            "default": 1
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "UpdateCartItemDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "quantity"
        ]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string",
            "example": "Karim Ahmed"
          },
          "phone": {
            "type": "string",
            "example": "01712345678"
          },
          "address": {
            "type": "string",
            "example": "House 12, Road 5, Dhanmondi, Dhaka"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          },
          "deliveryZone": {
            "type": "string",
            "enum": [
              "inside_dhaka",
              "outside_dhaka"
            ],
            "description": "Required only if any item is not free-delivery"
          },
          "notes": {
            "type": "string",
            "default": ""
          },
          "company": {
            "type": "string",
            "description": "Honeypot — hidden from real customers, must stay empty"
          }
        },
        "required": [
          "customerName",
          "phone",
          "address",
          "items"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "delivered",
              "cancelled",
              "rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateHeroBannerDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Winter Combo Offer"
          },
          "subtitle": {
            "type": "string",
            "default": ""
          },
          "imageUrl": {
            "type": "string",
            "description": "Public URL from POST /uploads"
          },
          "ctaLabel": {
            "type": "string",
            "default": ""
          },
          "ctaUrl": {
            "type": "string",
            "default": "",
            "example": "/products/winter-combo"
          },
          "position": {
            "type": "number",
            "description": "Lower shows first",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "title",
          "imageUrl"
        ]
      },
      "UpdateHeroBannerDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Winter Combo Offer"
          },
          "subtitle": {
            "type": "string",
            "default": ""
          },
          "imageUrl": {
            "type": "string",
            "description": "Public URL from POST /uploads"
          },
          "ctaLabel": {
            "type": "string",
            "default": ""
          },
          "ctaUrl": {
            "type": "string",
            "default": "",
            "example": "/products/winter-combo"
          },
          "position": {
            "type": "number",
            "description": "Lower shows first",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  }
}